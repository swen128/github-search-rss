            }
        },
        {
            "content_html": "<img src=\"https://avatars.githubusercontent.com/u/36607?u=79d8c114db476a7ecc6328b328f71d9d758368c7&v=4\" width=\"64\" height=\"64\" alt=\"\"/><br/><p dir=\"auto\">Our help pages will still be in man format, and displayed via man, but we do not need to support <code class=\"notranslate\">man install</code> opening npm cli docs.</p>",
            "url": "https://github.com/npm/statusboard/issues/1071",
            "title": "stop installing actual man pages",
            "date_modified": "2026-02-24T21:02:29.000Z",
            "date_published": "2026-02-24T21:01:32.000Z",
            "author": {
